        ],
        "type": "object",
        "properties": {
          "hashDoTermo": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PedidoDeDesconsideracao": {
        "required": [
          "nsr",
          "motivo"
        ],
        "type": "object",
        "properties": {
          "nsr": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "motivo": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PedidoDeEstabelecimento": {
        "required": [
          "local",
          "fuso"
        ],
        "type": "object",
        "properties": {
          "local": {
            "type": "string"
          },
          "fuso": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PedidoDeFeriado": {
        "required": [
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PedidoDeHorario": {
        "required": [
          "semana",
          "descansoSemanal",
          "intervaloPreAssinalado"
        ],
        "type": "object",
        "properties": {
          "semana": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "descansoSemanal": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "intervaloPreAssinalado": {
            "type": "boolean"
          },
          "intervaloNegociadoEmMinutos": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "viradaDoDia": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "PedidoDeInclusao": {
        "required": [
          "marcadaEm",
          "motivo"
        ],
        "type": "object",
        "properties": {
          "marcadaEm": {
            "type": "string",
            "format": "date-time"
          },
          "motivo": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PedidoDeMarcacao": {
        "required": [
          "coletor"
        ],
        "type": "object",
        "properties": {
          "coletor": {
            "$ref": "#/components/schemas/Coletor"
          }
        },
        "additionalProperties": false
      },
      "PedidoDeTrabalhador": {
        "required": [
          "nome",
          "admissao",
          "cargo"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "admissao": {
            "type": "string",
            "format": "date"
          },
          "cargo": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PedidoSobreTrabalhador": {
        "required": [
          "cpf"
        ],
        "type": "object",
        "properties": {
          "cpf": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "TermoMostrado": {
        "required": [
          "versao",
          "texto",
          "hash",
          "finalidade"
        ],
        "type": "object",
        "properties": {
          "versao": {
