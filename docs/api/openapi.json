  "components": {
    "schemas": {
      "Coletor": {
        "enum": [
          "AplicativoMovel",
          "Navegador",
          "AplicativoDesktop",
          "DispositivoEletronico",
          "Outro"
        ]
      },
      "PedidoDeAbono": {
        "required": [
          "dia",
          "motivo"
        ],
        "type": "object",
        "properties": {
          "dia": {
            "type": "string",
            "format": "date"
          },
          "motivo": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PedidoDeAutorizacao": {
        "required": [
