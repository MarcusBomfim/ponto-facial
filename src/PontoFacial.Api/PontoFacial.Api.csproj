<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    A API REST do ponto (ADR-0017): o cadastro, o registro, a marcação com
    o comprovante em PDF assinado, o tratamento, o espelho, o AFD e o AEJ com
    o .p7s, e a biometria por consentimento. Os papéis de RH, gestor e
    trabalhador vêm no token, e a empresa também.
  -->
  <PropertyGroup>
    <RootNamespace>PontoFacial.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PontoFacial.Assinaturas\PontoFacial.Assinaturas.csproj" />
    <ProjectReference Include="..\PontoFacial.Persistencia\PontoFacial.Persistencia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PontoFacial.Api.Testes" />
  </ItemGroup>
</Project>
