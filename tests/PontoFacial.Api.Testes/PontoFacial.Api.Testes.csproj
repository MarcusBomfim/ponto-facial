<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <RootNamespace>PontoFacial.Api.Testes</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PontoFacial.Api\PontoFacial.Api.csproj" />
  </ItemGroup>
  <!--
    O PostgreSQL de verdade e os exemplos, dos testes da persistência e do
    domínio: a API é testada contra o mesmo banco, com as mesmas pessoas.
  -->
  <ItemGroup>
    <Compile Include="..\PontoFacial.Persistencia.Testes\BancoDeTestes.cs" Link="Exemplos\BancoDeTestes.cs" />
    <Compile Include="..\PontoFacial.Dominio.Testes\Exemplos.cs" Link="Exemplos\Exemplos.cs" />
    <Compile Include="..\PontoFacial.Dominio.Testes\Jornada\Horarios.cs" Link="Exemplos\Horarios.cs" />
  </ItemGroup>
</Project>
